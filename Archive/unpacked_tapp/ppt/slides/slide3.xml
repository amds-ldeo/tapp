            <a:r>
              <a:rPr lang="en-US" dirty="0"/>
              <a:t>Issues in Metadata Reporting and Curation</a:t>
            </a:r>
          </a:p>
        </p:txBody>
      </p:sp>
      <p:sp>
        <p:nvSpPr>
